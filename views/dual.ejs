<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Synchronous Dual Visualizer - AlgoVisual</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script>
    if (localStorage.getItem('theme') === 'light') {
      document.documentElement.classList.add('light-theme');
    }
  </script>
  <style>
    .dual-bars-container {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      height: 220px;
      width: 100%;
      gap: 4px;
    }
    .dual-bar-col {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
      height: 100%;
      position: relative;
    }
    .dual-bar {
      width: 100%;
      border-radius: 3px 3px 0 0;
      transition: height 0.15s ease, background 0.15s ease;
    }
    .dual-bar.normal { background: linear-gradient(to top, #1e3a5f, #2563eb44); border: 1px solid #2563eb44; }
    .dual-bar.highlight { background: linear-gradient(to top, rgba(6,182,212,0.8), rgba(6,182,212,0.3)); border: 1px solid rgba(6,182,212,0.9); box-shadow: 0 0 10px rgba(6,182,212,0.6); }
    .dual-bar.completed { background: linear-gradient(to top, rgba(34,197,94,0.6), rgba(34,197,94,0.2)); border: 1px solid rgba(34,197,94,0.7); }
    .algo-select {
      background: #090d15;
      border: 1px solid #1e293b;
      color: #00e1d9;
      font-size: 11px;
      border-radius: 4px;
      padding: 5px 10px;
      font-family: 'Courier New', monospace;
      font-weight: bold;
      outline: none;
    }
  </style>
</head>
<body class="min-h-screen p-4 sm:p-6 relative overflow-x-hidden">
  
  <div class="max-w-7xl mx-auto flex flex-col min-h-[90vh]">
    
    <!-- Top Nav bar -->
    <div class="flex justify-between items-center mb-6">
      <div class="flex items-center gap-3">
        <a href="/" class="tech-btn px-4 py-2 rounded text-xs transition duration-200 flex items-center gap-2">
          <span>⬅</span> Back to Dashboard
        </a>
        <button id="theme-toggle" class="tech-btn p-2 rounded text-xs flex items-center justify-center w-8 h-8" title="Toggle Light/Dark Theme">
          <span id="theme-toggle-icon">☀️</span>
        </button>
      </div>
      <div class="text-right">
        <h2 class="text-[10px] text-slate-500 uppercase tracking-widest font-technical">Synchronous Dual Playroom</h2>
        <h1 class="text-lg font-bold text-[#00e1d9] font-technical uppercase">Twin-Playground Mode</h1>
      </div>
    </div>

    <!-- Dual Configuration Bar -->
    <div class="cyber-panel p-4 mb-6 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-4 flex-wrap">
        <div class="flex items-center gap-2">
          <span class="text-[10px] text-slate-400 font-technical uppercase tracking-wider">Engine A:</span>
          <select id="select-algo-a" class="algo-select">
            <option value="bubbleSort" <%= algoA === 'bubbleSort' ? 'selected' : '' %>>Bubble Sort</option>
            <option value="selectionSort" <%= algoA === 'selectionSort' ? 'selected' : '' %>>Selection Sort</option>
            <option value="insertionSort" <%= algoA === 'insertionSort' ? 'selected' : '' %>>Insertion Sort</option>
            <option value="quickSort" <%= algoA === 'quickSort' ? 'selected' : '' %>>Quick Sort</option>
            <option value="heapSort" <%= algoA === 'heapSort' ? 'selected' : '' %>>Heap Sort</option>
            <option value="mergeSort" <%= algoA === 'mergeSort' ? 'selected' : '' %>>Merge Sort</option>
            <option value="countingSort" <%= algoA === 'countingSort' ? 'selected' : '' %>>Counting Sort</option>
          </select>
        </div>

        <span class="text-slate-600 font-technical font-bold text-sm">VS</span>

        <div class="flex items-center gap-2">
          <span class="text-[10px] text-slate-400 font-technical uppercase tracking-wider">Engine B:</span>
          <select id="select-algo-b" class="algo-select">
            <option value="bubbleSort" <%= algoB === 'bubbleSort' ? 'selected' : '' %>>Bubble Sort</option>
            <option value="selectionSort" <%= algoB === 'selectionSort' ? 'selected' : '' %>>Selection Sort</option>
            <option value="insertionSort" <%= algoB === 'insertionSort' ? 'selected' : '' %>>Insertion Sort</option>
            <option value="quickSort" <%= algoB === 'quickSort' ? 'selected' : '' %>>Quick Sort</option>
            <option value="heapSort" <%= algoB === 'heapSort' ? 'selected' : '' %>>Heap Sort</option>
            <option value="mergeSort" <%= algoB === 'mergeSort' ? 'selected' : '' %>>Merge Sort</option>
            <option value="countingSort" <%= algoB === 'countingSort' ? 'selected' : '' %>>Counting Sort</option>
          </select>
        </div>
      </div>

      <div class="flex items-center gap-2 flex-wrap">
        <input type="text" id="input-array" class="tech-input text-xs bg-slate-950 border border-slate-900 rounded px-3 py-1.5 w-48 font-technical text-slate-200" value="23, 45, 12, 56, 34, 18, 9, 41">
        <button id="btn-apply" class="tech-btn text-xs px-3 py-1.5 rounded font-bold uppercase tracking-wider">Apply</button>
        <button id="btn-random" class="tech-btn text-xs px-3 py-1.5 rounded font-bold uppercase tracking-wider">Randomize</button>
      </div>
    </div>

    <!-- Twin Viewports (Side-by-Side Grid) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      
      <!-- Viewport A -->
      <div class="cyber-panel p-6 flex flex-col justify-between space-y-4">
        <div class="flex justify-between items-center border-b border-slate-900 pb-2">
          <h2 id="title-viewport-a" class="text-sm font-bold text-cyan-400 font-technical uppercase">Engine A</h2>
          <span id="badge-status-a" class="text-[9px] font-technical bg-slate-900 border border-slate-800 text-slate-400 px-2 py-0.5 rounded font-bold uppercase">READY</span>
        </div>

        <div class="border border-slate-900 bg-slate-950/40 rounded p-4 relative overflow-hidden flex items-center justify-center">
          <div id="container-bars-a" class="dual-bars-container"></div>
        </div>

        <div class="bg-slate-950/60 p-3 rounded border border-slate-900 text-xs font-mono text-slate-300 min-h-[48px] flex items-center" id="desc-a">
          Initial state ready.
        </div>

        <div class="grid grid-cols-2 gap-2 text-[10px] font-technical">
          <div class="bg-slate-950/40 p-2 rounded border border-slate-900">
            <span class="text-slate-500 uppercase block">Comparisons</span>
            <span id="stat-comp-a" class="text-sm font-bold text-amber-400">0</span>
          </div>
          <div class="bg-slate-950/40 p-2 rounded border border-slate-900">
            <span class="text-slate-500 uppercase block">Swaps / Writes</span>
            <span id="stat-swap-a" class="text-sm font-bold text-rose-400">0</span>
          </div>
        </div>
      </div>

      <!-- Viewport B -->
      <div class="cyber-panel p-6 flex flex-col justify-between space-y-4">
        <div class="flex justify-between items-center border-b border-slate-900 pb-2">
          <h2 id="title-viewport-b" class="text-sm font-bold text-cyan-400 font-technical uppercase">Engine B</h2>
          <span id="badge-status-b" class="text-[9px] font-technical bg-slate-900 border border-slate-800 text-slate-400 px-2 py-0.5 rounded font-bold uppercase">READY</span>
        </div>

        <div class="border border-slate-900 bg-slate-950/40 rounded p-4 relative overflow-hidden flex items-center justify-center">
          <div id="container-bars-b" class="dual-bars-container"></div>
        </div>

        <div class="bg-slate-950/60 p-3 rounded border border-slate-900 text-xs font-mono text-slate-300 min-h-[48px] flex items-center" id="desc-b">
          Initial state ready.
        </div>

        <div class="grid grid-cols-2 gap-2 text-[10px] font-technical">
          <div class="bg-slate-950/40 p-2 rounded border border-slate-900">
            <span class="text-slate-500 uppercase block">Comparisons</span>
            <span id="stat-comp-b" class="text-sm font-bold text-amber-400">0</span>
          </div>
          <div class="bg-slate-950/40 p-2 rounded border border-slate-900">
            <span class="text-slate-500 uppercase block">Swaps / Writes</span>
            <span id="stat-swap-b" class="text-sm font-bold text-rose-400">0</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Unified Playback Control Bar -->
    <div class="cyber-panel p-6 flex flex-col sm:flex-row gap-4 items-center justify-between">
      <div class="flex items-center gap-3">
        <button id="btn-prev" class="tech-btn p-3 rounded text-xs flex items-center gap-2" title="Step Backward">
          <span>⏮</span> Step Back
        </button>
        <button id="btn-play" class="tech-btn tech-btn-primary px-6 py-3 rounded text-xs font-bold uppercase tracking-wider flex items-center gap-2">
          <span>▶</span> Synchronized Play
        </button>
        <button id="btn-next" class="tech-btn p-3 rounded text-xs flex items-center gap-2" title="Step Forward">
          <span>⏭</span> Step Next
        </button>
        <button id="btn-reset" class="tech-btn p-3 rounded text-xs flex items-center gap-2" title="Reset Playroom">
          <span>🔄</span> Reset
        </button>
        <span id="step-counter" class="text-xs text-slate-400 font-technical font-bold border border-slate-900 bg-slate-950 px-3 py-3 rounded select-none min-w-[95px] text-center">Step 0 / 0</span>
      </div>

      <div class="flex items-center gap-3 w-full sm:w-auto">
        <span class="text-[10px] text-slate-500 font-technical uppercase tracking-wider">Speed</span>
        <input type="range" id="slider-speed" min="0.5" max="3.0" step="0.1" value="1.0" class="tech-slider w-28 cursor-pointer">
        <span id="text-speed" class="text-xs font-technical font-bold text-[#00e1d9]">1.0x</span>
      </div>
    </div>

  </div>

  <script type="module" src="/js/dualPlayer.js"></script>
</body>
</html>
