    </div>

    <!-- Comparison Board Section (full-width) -->
    <div class="cyber-panel p-6 sm:p-8 space-y-4 mt-8">
      <div class="flex justify-between items-center border-b border-slate-900 pb-3">
        <h2 class="text-md font-bold text-slate-200 tracking-wider uppercase font-technical flex items-center gap-2">
          <span class="text-[#00e1d9]">▶</span> MODULE 04: Algorithm Comparison Board
        </h2>
        <span class="text-[10px] font-technical bg-slate-900 border border-slate-800 text-slate-500 px-2 py-0.5 rounded font-bold uppercase">ACTIVE</span>
      </div>
      <p class="text-[11px] text-slate-400 font-light leading-relaxed">Run two sorting algorithms side-by-side on identical arrays. Compare total steps, swaps, and comparisons in synchronized real-time playback.</p>
      <div class="space-y-3 pt-2">
        <a href="/compare" class="block p-4 border border-slate-900 bg-slate-950/40 hover:border-[#00e1d9]/60 hover:bg-[#00e1d9]/5 rounded transition duration-200 group relative overflow-hidden">
          <div class="absolute top-0 right-0 w-[2px] h-full bg-[#00e1d9]/50 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
          <div class="flex justify-between items-center">
            <div>
              <div class="flex items-center gap-2">
                <span class="led-indicator led-active"></span>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-technical group-hover:text-white">Open Comparison Board</h3>
              </div>
              <p class="text-[10px] text-slate-500 mt-1 font-light">Select any two algorithms and compare performance metrics side-by-side.</p>
            </div>
            <span class="text-slate-600 group-hover:text-[#00e1d9] group-hover:translate-x-1 transition duration-200 font-technical text-xs font-bold">LOAD ➔</span>
          </div>
        </a>
      </div>
    </div>

  </div>
  
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggleBtn = document.getElementById('theme-toggle');
      const toggleIcon = document.getElementById('theme-toggle-icon');
      
      const updateToggleIcon = () => {
        if (toggleIcon) {
          const isLight = document.documentElement.classList.contains('light-theme');
          toggleIcon.textContent = isLight ? '🌙' : '☀️';
        }
      };
      
      updateToggleIcon();
      
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const isLight = document.documentElement.classList.toggle('light-theme');
          localStorage.setItem('theme', isLight ? 'light' : 'dark');
          updateToggleIcon();
        });
      }
    });
  </script>
</body>
</html>
