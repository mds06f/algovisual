  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggleBtn = document.getElementById('theme-toggle');
      const toggleIcon = document.getElementById('theme-toggle-icon');
      
      const updateToggleIcon = () => {
        if (toggleIcon) {
          const isLight = document.documentElement.classList.contains('light-theme');
          toggleIcon.textContent = isLight ? '🌙' : '☀️';
        }
      };
      
      updateToggleIcon();
      
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const isLight = document.documentElement.classList.toggle('light-theme');
          localStorage.setItem('theme', isLight ? 'light' : 'dark');
          updateToggleIcon();
        });
      }

      // Increment and load dashboard telemetry statistics
      let visits = parseInt(localStorage.getItem('algovisual_visits') || '0', 10);
      visits++;
      localStorage.setItem('algovisual_visits', visits);
      const visitsElem = document.getElementById('stat-visits-count');
      if (visitsElem) visitsElem.textContent = visits;

      const explorations = parseInt(localStorage.getItem('algovisual_explorations') || '0', 10);
      const explorationsElem = document.getElementById('stat-explorations-count');
      if (explorationsElem) explorationsElem.textContent = explorations;

      const classrooms = parseInt(localStorage.getItem('algovisual_rooms') || '0', 10);
      const classroomsElem = document.getElementById('stat-classrooms-count');
      if (classroomsElem) classroomsElem.textContent = classrooms;

      // Algorithm Search & Filter Logic
      const searchInput = document.getElementById('search-algo');
      const filterChips = document.querySelectorAll('.filter-chip');
      const algoCards = document.querySelectorAll('.algo-card');
      const noAlgosMsg = document.getElementById('no-algos-msg');

      let currentCategory = 'all';

      const filterCards = () => {
        const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
        let visibleCount = 0;

        algoCards.forEach(card => {
          const cardText = card.textContent.toLowerCase();
          const cardCategory = card.getAttribute('data-category') || '';
          
          const matchesCategory = currentCategory === 'all' || cardCategory.toLowerCase() === currentCategory.toLowerCase();
          const matchesQuery = !query || cardText.includes(query);

          if (matchesCategory && matchesQuery) {
            card.style.display = 'block';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (noAlgosMsg) {
          noAlgosMsg.classList.toggle('hidden', visibleCount > 0);
        }
      };

      if (searchInput) {
        searchInput.addEventListener('input', filterCards);
      }

      filterChips.forEach(chip => {
        chip.addEventListener('click', () => {
          filterChips.forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          currentCategory = chip.getAttribute('data-filter') || 'all';
          filterCards();
        });
      });

      // PWA Service Worker Registration
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .then(reg => console.log('ServiceWorker registered with scope: ', reg.scope))
            .catch(err => console.error('ServiceWorker registration failed: ', err));
        });
      }
    });
  </script>
