<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AlgoVisual - Algorithm Telemetry Console</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script>
    if (localStorage.getItem('theme') === 'light') {
      document.documentElement.classList.add('light-theme');
    }
  </script>
</head>
<body class="min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden">
  
  <!-- Theme Toggle Button -->
  <div class="absolute top-4 right-4">
    <button id="theme-toggle" class="tech-btn p-2 rounded text-xs flex items-center justify-center w-8 h-8" title="Toggle Light/Dark Theme">
      <span id="theme-toggle-icon">☀️</span>
    </button>
  </div>
  
  <div class="max-w-4xl w-full py-8">
    <!-- Header -->
    <div class="text-center mb-10">
      <div class="inline-block relative mb-3">
        <span class="text-4xl filter drop-shadow-[0_0_8px_rgba(6,182,212,0.6)]">🎛️</span>
      </div>
      <h1 class="text-4xl font-extrabold tracking-wider font-technical uppercase text-[#00e1d9] drop-shadow-[0_0_10px_rgba(6,182,212,0.3)]">
        AlgoVisual Telemetry Console
      </h1>
      <p class="text-slate-400 mt-2 font-light tracking-widest text-xs uppercase">
        Interactive cs state-machine animation engine & analysis deck
      </p>
    </div>

    <!-- Algorithm Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Sorting Section -->
      <div class="cyber-panel p-6 sm:p-8 space-y-4">
        <div class="flex justify-between items-center border-b border-slate-900 pb-3">
          <h2 class="text-md font-bold text-slate-200 tracking-wider uppercase font-technical flex items-center gap-2">
            <span class="text-[#00e1d9]">▶</span> MODULE 01: Sorting Systems
          </h2>
          <span class="text-[10px] font-technical bg-slate-900 border border-slate-800 text-slate-500 px-2 py-0.5 rounded font-bold uppercase">ACTIVE</span>
        </div>
        <p class="text-[11px] text-slate-400 font-light leading-relaxed">Sequence rearranger sub-routines. Telemetry evaluates swap iterations, element comparisons, and value migrations.</p>
        
        <div class="space-y-3 pt-2">
          <!-- Bubble Sort Link -->
          <a href="/visualizer?algo=bubbleSort" class="block p-4 border border-slate-900 bg-slate-950/40 hover:border-[#00e1d9]/60 hover:bg-[#00e1d9]/5 rounded transition duration-200 group relative overflow-hidden">
            <div class="absolute top-0 right-0 w-[2px] h-full bg-[#00e1d9]/50 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
            <div class="flex justify-between items-center">
              <div>
                <div class="flex items-center gap-2">
                  <span class="led-indicator led-active"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-technical group-hover:text-white">Bubble Sort</h3>
                </div>
                <p class="text-[10px] text-slate-500 mt-1 font-light">Adjacent element comparative sweep logic.</p>
              </div>
              <span class="text-slate-600 group-hover:text-[#00e1d9] group-hover:translate-x-1 transition duration-200 font-technical text-xs font-bold">LOAD ➔</span>
            </div>
          </a>

          <!-- Selection Sort Link -->
          <a href="/visualizer?algo=selectionSort" class="block p-4 border border-slate-900 bg-slate-950/40 hover:border-[#00e1d9]/60 hover:bg-[#00e1d9]/5 rounded transition duration-200 group relative overflow-hidden">
            <div class="absolute top-0 right-0 w-[2px] h-full bg-[#00e1d9]/50 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
            <div class="flex justify-between items-center">
              <div>
                <div class="flex items-center gap-2">
                  <span class="led-indicator led-active"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-technical group-hover:text-white">Selection Sort</h3>
                </div>
                <p class="text-[10px] text-slate-500 mt-1 font-light">Locate local extrema and index shift updates.</p>
              </div>
              <span class="text-slate-600 group-hover:text-[#00e1d9] group-hover:translate-x-1 transition duration-200 font-technical text-xs font-bold">LOAD ➔</span>
            </div>
          </a>

          <!-- Insertion Sort Link -->
          <a href="/visualizer?algo=insertionSort" class="block p-4 border border-slate-900 bg-slate-950/40 hover:border-[#00e1d9]/60 hover:bg-[#00e1d9]/5 rounded transition duration-200 group relative overflow-hidden">
            <div class="absolute top-0 right-0 w-[2px] h-full bg-[#00e1d9]/50 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
            <div class="flex justify-between items-center">
              <div>
                <div class="flex items-center gap-2">
                  <span class="led-indicator led-active"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-technical group-hover:text-white">Insertion Sort</h3>
                </div>
                <p class="text-[10px] text-slate-500 mt-1 font-light">Build sorted array index by index comparative placement.</p>
              </div>
              <span class="text-slate-600 group-hover:text-[#00e1d9] group-hover:translate-x-1 transition duration-200 font-technical text-xs font-bold">LOAD ➔</span>
            </div>
          </a>

          <!-- Quick Sort Link -->
          <a href="/visualizer?algo=quickSort" class="block p-4 border border-slate-900 bg-slate-950/40 hover:border-[#00e1d9]/60 hover:bg-[#00e1d9]/5 rounded transition duration-200 group relative overflow-hidden">
            <div class="absolute top-0 right-0 w-[2px] h-full bg-[#00e1d9]/50 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
            <div class="flex justify-between items-center">
              <div>
                <div class="flex items-center gap-2">
                  <span class="led-indicator led-active"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-technical group-hover:text-white">Quick Sort</h3>
                </div>
                <p class="text-[10px] text-slate-500 mt-1 font-light">Partition-based divide-and-conquer sorting routine.</p>
              </div>
              <span class="text-slate-600 group-hover:text-[#00e1d9] group-hover:translate-x-1 transition duration-200 font-technical text-xs font-bold">LOAD ➔</span>
            </div>
          </a>

          <!-- Heap Sort Link -->
          <a href="/visualizer?algo=heapSort" class="block p-4 border border-slate-900 bg-slate-950/40 hover:border-[#00e1d9]/60 hover:bg-[#00e1d9]/5 rounded transition duration-200 group relative overflow-hidden">
            <div class="absolute top-0 right-0 w-[2px] h-full bg-[#00e1d9]/50 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
            <div class="flex justify-between items-center">
              <div>
                <div class="flex items-center gap-2">
                  <span class="led-indicator led-active"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-technical group-hover:text-white">Heap Sort</h3>
                </div>
                <p class="text-[10px] text-slate-500 mt-1 font-light">Max-Heap binary tree construction and element extraction routine.</p>
              </div>
              <span class="text-slate-600 group-hover:text-[#00e1d9] group-hover:translate-x-1 transition duration-200 font-technical text-xs font-bold">LOAD ➔</span>
            </div>
          </a>

          <!-- Merge Sort Link -->
          <a href="/visualizer?algo=mergeSort" class="block p-4 border border-slate-900 bg-slate-950/40 hover:border-[#00e1d9]/60 hover:bg-[#00e1d9]/5 rounded transition duration-200 group relative overflow-hidden">
            <div class="absolute top-0 right-0 w-[2px] h-full bg-[#00e1d9]/50 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
            <div class="flex justify-between items-center">
              <div>
                <div class="flex items-center gap-2">
                  <span class="led-indicator led-active"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-technical group-hover:text-white">Merge Sort</h3>
                </div>
                <p class="text-[10px] text-slate-500 mt-1 font-light">Divide-and-conquer merge with auxiliary split canvas view.</p>
              </div>
              <span class="text-slate-600 group-hover:text-[#00e1d9] group-hover:translate-x-1 transition duration-200 font-technical text-xs font-bold">LOAD ➔</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Searching Section -->
      <div class="cyber-panel p-6 sm:p-8 space-y-4">
        <div class="flex justify-between items-center border-b border-slate-900 pb-3">
          <h2 class="text-md font-bold text-slate-200 tracking-wider uppercase font-technical flex items-center gap-2">
            <span class="text-[#00e1d9]">▶</span> MODULE 02: Searching Systems
          </h2>
          <span class="text-[10px] font-technical bg-slate-900 border border-slate-800 text-slate-500 px-2 py-0.5 rounded font-bold uppercase">ACTIVE</span>
        </div>
        <p class="text-[11px] text-slate-400 font-light leading-relaxed">Target value location routines. Telemetry evaluates search-space boundaries, division steps, and matches.</p>
        
        <div class="space-y-3 pt-2">
          <!-- Binary Search Link -->
          <a href="/visualizer?algo=binarySearch" class="block p-4 border border-slate-900 bg-slate-950/40 hover:border-[#00e1d9]/60 hover:bg-[#00e1d9]/5 rounded transition duration-200 group relative overflow-hidden">
            <div class="absolute top-0 right-0 w-[2px] h-full bg-[#00e1d9]/50 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
            <div class="flex justify-between items-center">
              <div>
                <div class="flex items-center gap-2">
                  <span class="led-indicator led-active"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-technical group-hover:text-white">Binary Search</h3>
                </div>
                <p class="text-[10px] text-slate-500 mt-1 font-light">Segment bifurcation boundary lookup sweep.</p>
              </div>
              <span class="text-slate-600 group-hover:text-[#00e1d9] group-hover:translate-x-1 transition duration-200 font-technical text-xs font-bold">LOAD ➔</span>
            </div>
          </a>

          <!-- Linear Search Link -->
          <a href="/visualizer?algo=linearSearch" class="block p-4 border border-slate-900 bg-slate-950/40 hover:border-[#00e1d9]/60 hover:bg-[#00e1d9]/5 rounded transition duration-200 group relative overflow-hidden">
            <div class="absolute top-0 right-0 w-[2px] h-full bg-[#00e1d9]/50 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
            <div class="flex justify-between items-center">
              <div>
                <div class="flex items-center gap-2">
                  <span class="led-indicator led-active"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-technical group-hover:text-white">Linear Search</h3>
                </div>
                <p class="text-[10px] text-slate-500 mt-1 font-light">Sequential element evaluation index scans.</p>
              </div>
              <span class="text-slate-600 group-hover:text-[#00e1d9] group-hover:translate-x-1 transition duration-200 font-technical text-xs font-bold">LOAD ➔</span>
            </div>
          </a>

          <!-- Min/Max Finder Link -->
          <a href="/visualizer?algo=minMaxFinder" class="block p-4 border border-slate-900 bg-slate-950/40 hover:border-[#00e1d9]/60 hover:bg-[#00e1d9]/5 rounded transition duration-200 group relative overflow-hidden">
            <div class="absolute top-0 right-0 w-[2px] h-full bg-[#00e1d9]/50 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
            <div class="flex justify-between items-center">
              <div>
                <div class="flex items-center gap-2">
                  <span class="led-indicator led-active"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-technical group-hover:text-white">Min/Max Finder</h3>
                </div>
                <p class="text-[10px] text-slate-500 mt-1 font-light">Locate array minimum and maximum values sequentially.</p>
              </div>
              <span class="text-slate-600 group-hover:text-[#00e1d9] group-hover:translate-x-1 transition duration-200 font-technical text-xs font-bold">LOAD ➔</span>
            </div>
          </a>

          <!-- Reverse Array Link -->
          <a href="/visualizer?algo=reverseArray" class="block p-4 border border-slate-900 bg-slate-950/40 hover:border-[#00e1d9]/60 hover:bg-[#00e1d9]/5 rounded transition duration-200 group relative overflow-hidden">
            <div class="absolute top-0 right-0 w-[2px] h-full bg-[#00e1d9]/50 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
            <div class="flex justify-between items-center">
              <div>
                <div class="flex items-center gap-2">
                  <span class="led-indicator led-active"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-technical group-hover:text-white">Reverse Array</h3>
                </div>
                <p class="text-[10px] text-slate-500 mt-1 font-light">Two-pointer in-place array reversing routine.</p>
              </div>
              <span class="text-slate-600 group-hover:text-[#00e1d9] group-hover:translate-x-1 transition duration-200 font-technical text-xs font-bold">LOAD ➔</span>
            </div>
          </a>

          <!-- Fibonacci Sequence Link -->
          <a href="/visualizer?algo=fibonacci" class="block p-4 border border-slate-900 bg-slate-950/40 hover:border-[#00e1d9]/60 hover:bg-[#00e1d9]/5 rounded transition duration-200 group relative overflow-hidden">
            <div class="absolute top-0 right-0 w-[2px] h-full bg-[#00e1d9]/50 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
            <div class="flex justify-between items-center">
              <div>
                <div class="flex items-center gap-2">
                  <span class="led-indicator led-active"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-technical group-hover:text-white">Fibonacci Sequence</h3>
                </div>
                <p class="text-[10px] text-slate-500 mt-1 font-light">Sequential additive Fibonacci number generator.</p>
              </div>
              <span class="text-slate-600 group-hover:text-[#00e1d9] group-hover:translate-x-1 transition duration-200 font-technical text-xs font-bold">LOAD ➔</span>
            </div>
          </a>

          <!-- BST Insertion Link -->
          <a href="/visualizer?algo=bstInsert" class="block p-4 border border-slate-900 bg-slate-950/40 hover:border-[#00e1d9]/60 hover:bg-[#00e1d9]/5 rounded transition duration-200 group relative overflow-hidden">
            <div class="absolute top-0 right-0 w-[2px] h-full bg-[#00e1d9]/50 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
            <div class="flex justify-between items-center">
              <div>
                <div class="flex items-center gap-2">
                  <span class="led-indicator led-active"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-technical group-hover:text-white">BST Insertion</h3>
                </div>
                <p class="text-[10px] text-slate-500 mt-1 font-light">Binary Search Tree step-by-step key insertion traversal.</p>
              </div>
              <span class="text-slate-600 group-hover:text-[#00e1d9] group-hover:translate-x-1 transition duration-200 font-technical text-xs font-bold">LOAD ➔</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Pathfinding Section -->
      <div class="cyber-panel p-6 sm:p-8 space-y-4 md:col-span-2">
        <div class="flex justify-between items-center border-b border-slate-900 pb-3">
          <h2 class="text-md font-bold text-slate-200 tracking-wider uppercase font-technical flex items-center gap-2">
            <span class="text-[#00e1d9]">▶</span> MODULE 03: Pathfinding Systems
          </h2>
          <span class="text-[10px] font-technical bg-slate-900 border border-slate-800 text-slate-500 px-2 py-0.5 rounded font-bold uppercase">ACTIVE</span>
        </div>
        <p class="text-[11px] text-slate-400 font-light leading-relaxed">Grid search traversal routines. Telemetry evaluates node states, visited pathways, and target distance bounds.</p>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <!-- Dijkstra Link -->
          <a href="/visualizer?algo=dijkstra" class="block p-4 border border-slate-900 bg-slate-950/40 hover:border-[#00e1d9]/60 hover:bg-[#00e1d9]/5 rounded transition duration-200 group relative overflow-hidden">
            <div class="absolute top-0 right-0 w-[2px] h-full bg-[#00e1d9]/50 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
            <div class="flex justify-between items-center">
              <div>
                <div class="flex items-center gap-2">
                  <span class="led-indicator led-active"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-technical group-hover:text-white">Dijkstra's Algorithm</h3>
                </div>
                <p class="text-[10px] text-slate-500 mt-1 font-light">Shortest path coordinate traversal bypassing wall blocks.</p>
              </div>
              <span class="text-slate-600 group-hover:text-[#00e1d9] group-hover:translate-x-1 transition duration-200 font-technical text-xs font-bold">LOAD ➔</span>
            </div>
          </a>

          <!-- A* Search Link -->
          <a href="/visualizer?algo=aStar" class="block p-4 border border-slate-900 bg-slate-950/40 hover:border-[#00e1d9]/60 hover:bg-[#00e1d9]/5 rounded transition duration-200 group relative overflow-hidden">
            <div class="absolute top-0 right-0 w-[2px] h-full bg-[#00e1d9]/50 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>
            <div class="flex justify-between items-center">
              <div>
                <div class="flex items-center gap-2">
                  <span class="led-indicator led-active"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 font-technical group-hover:text-white">A* Search Pathfinder</h3>
                </div>
                <p class="text-[10px] text-slate-500 mt-1 font-light">Heuristic-guided path finder (Manhattan, Chebyshev, Euclidean).</p>
              </div>
              <span class="text-slate-600 group-hover:text-[#00e1d9] group-hover:translate-x-1 transition duration-200 font-technical text-xs font-bold">LOAD ➔</span>
            </div>
          </a>
