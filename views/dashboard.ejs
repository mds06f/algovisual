        <button data-filter="Searching" class="filter-chip tech-btn px-3 py-1.5 rounded text-[10px] font-technical font-bold uppercase">Searching</button>
        <button data-filter="Pathfinding" class="filter-chip tech-btn px-3 py-1.5 rounded text-[10px] font-technical font-bold uppercase">Pathfinding</button>
