<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Algorithm Playground - AlgoVisual</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
  <script>
    if (localStorage.getItem('theme') === 'light') {
      document.documentElement.classList.add('light-theme');
    }
  </script>
</head>
<body class="min-h-screen p-4 sm:p-6 relative overflow-x-hidden">
  
  <div class="max-w-7xl mx-auto flex flex-col min-h-[90vh]">
    
    <!-- Top Nav bar -->
    <div class="flex justify-between items-center mb-6">
      <div class="flex items-center gap-3">
        <a href="/" class="tech-btn px-4 py-2 rounded text-xs transition duration-200 flex items-center gap-2">
          <span>⬅</span> Back to Dashboard
        </a>
        <button id="theme-toggle" class="tech-btn p-2 rounded text-xs flex items-center justify-center w-8 h-8" title="Toggle Light/Dark Theme">
          <span id="theme-toggle-icon">☀️</span>
        </button>
        <button id="btn-record" class="tech-btn px-3 py-2 rounded text-xs flex items-center gap-1.5 font-technical font-bold uppercase" title="Record Animation Stream (WebM Video Export)">
          <span id="record-icon">🔴</span> <span id="record-text">Record</span>
        </button>
        <div id="breadcrumb-nav" class="text-xs font-technical text-slate-400 hidden sm:flex items-center gap-1.5 ml-2">
          <a href="/" class="hover:text-[#00e1d9] transition">Home</a>
          <span>&gt;</span>
          <span id="breadcrumb-category" class="text-slate-400">Category</span>
          <span>&gt;</span>
          <span id="breadcrumb-algo" class="text-[#00e1d9] font-bold">Algorithm</span>
        </div>
      </div>
      <div class="text-right">
        <h2 class="text-[10px] text-slate-500 uppercase tracking-widest font-technical">Selected System Module</h2>
        <h1 id="algo-title" class="text-lg font-bold text-[#00e1d9] font-technical uppercase">Loading...</h1>
      </div>
    </div>

    <!-- Main Visualizer Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 flex-1 items-stretch">
      
      <!-- Canvas & Timeline (2 columns wide on large screens) -->
      <div class="lg:col-span-2 flex flex-col space-y-6">
        
        <!-- Canvas Card -->
        <div class="cyber-panel p-6 sm:p-8 flex-1 flex flex-col justify-between min-h-[400px]">
          <!-- Description Header -->
          <div class="border-b border-slate-900 pb-3 mb-4 flex justify-between items-start">
            <div>
              <span class="text-[10px] font-technical text-slate-500 uppercase tracking-wider">Module Specification</span>
              <p id="algo-desc" class="text-slate-400 text-xs font-light leading-relaxed mt-1"></p>
            </div>
          </div>

          <!-- Main Visualizer Viewport (Bars/Tape container) -->
          <div class="flex-1 flex items-center justify-center border border-slate-900 bg-slate-950/30 rounded p-4 relative overflow-hidden">
            <!-- Grid lines inside canvas -->
            <div class="absolute inset-0 bg-gradient-to-b from-transparent to-slate-950/20 pointer-events-none z-0"></div>
            <div id="bars-container" class="relative z-10 w-full h-full flex items-center justify-center">
              <!-- Dynamically populated elements go here -->
            </div>
          </div>
        </div>

        <!-- Controls Card -->
        <div class="cyber-panel p-6 flex flex-col sm:flex-row gap-4 items-center justify-between">
          <!-- Playback Buttons -->
          <div class="flex items-center gap-3">
            <button id="btn-undo" class="tech-btn p-3 rounded text-xs flex items-center gap-2" title="Undo / Deep Backtrack Action">
              <span>↩️</span> Undo
            </button>
            <button id="btn-prev" class="tech-btn p-3 rounded text-xs flex items-center gap-2" title="Step Backward">
              <span>⏮</span> Step Back
            </button>
            <button id="btn-play" class="tech-btn tech-btn-primary px-6 py-3 rounded text-xs font-bold uppercase tracking-wider flex items-center gap-2">
              <span>▶</span> Play
            </button>
            <button id="btn-next" class="tech-btn p-3 rounded text-xs flex items-center gap-2" title="Step Forward">
              <span>⏭</span> Step Next
            </button>
            <button id="btn-loop" class="tech-btn p-3 rounded text-xs flex items-center gap-2" title="Toggle Auto-Loop Mode">
              <span>🔁</span> Loop
            </button>
            <button id="btn-audio-toggle" class="tech-btn p-3 rounded text-xs flex items-center gap-2" title="Toggle Sound (Sonification)">
              <span id="audio-toggle-icon">🔇</span>
            </button>
            <button id="btn-audio-settings" class="tech-btn p-3 rounded text-xs" title="Sound Settings (Waveform & Pitch)">⚙</button>
            <span id="step-counter-text" class="text-xs text-slate-400 font-technical font-bold border border-slate-900 bg-slate-950 px-3 py-3 rounded select-none min-w-[95px] text-center">Step 0 / 0</span>
          </div>

          <!-- Audio Settings Drawer -->
          <div id="audio-settings-drawer" class="hidden w-full flex items-center gap-4 flex-wrap bg-[#090d16] border border-slate-900 rounded px-4 py-2">
            <div class="flex items-center gap-2">
              <span class="text-[9px] text-slate-500 font-technical uppercase tracking-wider">Waveform</span>
              <select id="select-waveform" class="tech-input text-xs bg-slate-950 border border-slate-900 rounded px-2 py-1.5 font-technical focus:outline-none">
                <option value="sine">Sine</option>
                <option value="triangle">Triangle</option>
                <option value="square">Square</option>
                <option value="sawtooth">Sawtooth</option>
              </select>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[9px] text-slate-500 font-technical uppercase tracking-wider">Pitch</span>
              <input type="range" id="slider-pitch" min="0.5" max="2.0" step="0.1" value="1.0" class="tech-slider w-20 cursor-pointer">
              <span id="text-pitch" class="text-[10px] text-[#00e1d9] font-bold font-technical">1.0x</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[9px] text-slate-500 font-technical uppercase tracking-wider">Harmony</span>
              <select id="select-harmony" class="tech-input text-xs bg-slate-950 border border-slate-900 rounded px-2 py-1.5 font-technical focus:outline-none">
                <option value="single">Single Tone</option>
                <option value="major">Major Triad</option>
                <option value="minor">Minor Triad</option>
                <option value="dynamic" selected>Auto Chords</option>
              </select>
            </div>
          </div>


          <!-- Speed Slider + Presets -->
          <div class="flex flex-col gap-2 w-full sm:w-auto">
            <div class="flex items-center gap-3">
              <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider font-technical">Speed:</span>
              <input type="range" id="slider-speed" min="0.5" max="3.0" step="0.25" value="1.0" class="tech-slider cursor-pointer">
              <span id="text-speed" class="text-xs text-[#00e1d9] font-bold font-technical">1.0x</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-[9px] text-slate-600 font-technical uppercase tracking-wider">Presets:</span>
              <button data-speed="0.5" class="speed-preset-btn tech-btn text-[9px] px-2 py-1 rounded font-technical font-bold">0.5x</button>
              <button data-speed="1.0" class="speed-preset-btn tech-btn text-[9px] px-2 py-1 rounded font-technical font-bold speed-preset-active">1.0x</button>
              <button data-speed="2.0" class="speed-preset-btn tech-btn text-[9px] px-2 py-1 rounded font-technical font-bold">2.0x</button>
              <button data-speed="5.0" class="speed-preset-btn tech-btn text-[9px] px-2 py-1 rounded font-technical font-bold">5.0x</button>
            </div>
          </div>

          <!-- Custom Inputs -->
          <div id="container-custom-inputs" class="flex items-center gap-2 w-full sm:w-auto flex-wrap">
            <select id="select-preset" class="tech-input text-xs bg-slate-950 border border-slate-900 rounded px-2 py-2 w-[110px] font-technical focus:outline-none" title="Select Array Preset">
              <option value="">-- Presets --</option>
              <option value="23,45,12,56,34,18,9,41">Default Array</option>
            </select>
            <button id="btn-delete-preset" class="tech-btn p-2 rounded text-xs" title="Delete selected custom preset" style="line-height:1">🗑</button>

            <div class="flex items-center bg-[#090d16] border border-slate-900 rounded p-1 gap-1 focus-within:border-cyan-500/40 focus-within:shadow-[0_0_10px_rgba(6,182,212,0.15)] transition duration-200">
              <input type="text" id="input-custom" class="bg-transparent border-none outline-none text-xs placeholder-slate-700 w-[120px] font-technical text-slate-200 px-2 py-1.5 focus:outline-none focus:ring-0" placeholder="e.g. 5,12,8,25">
              
              <div id="container-target-input" class="hidden flex items-center border-l border-slate-800 pl-2 gap-1.5">
                <span class="text-[9px] text-slate-500 font-bold uppercase tracking-wider font-technical">Target</span>
                <input type="text" id="input-target" class="bg-transparent border-none outline-none text-xs placeholder-slate-700 w-[35px] font-technical text-slate-200 text-center focus:outline-none focus:ring-0" placeholder="34" value="34">
              </div>
            </div>
            <button id="btn-apply-input" class="tech-btn text-xs px-4 py-2.5 rounded font-bold uppercase tracking-wider">
              Apply
            </button>
            <button id="btn-save-preset" class="tech-btn text-xs px-3 py-2.5 rounded font-bold uppercase tracking-wider" title="Save Current Array as Preset">
              Save
            </button>
            <button id="btn-reset" class="tech-btn text-xs px-3 py-2.5 rounded font-bold uppercase tracking-wider" title="Reset custom array and workspace state to default">
              Reset
            </button>
          </div>

          <!-- Data Structure Interactive Controls (Stack/Queue) -->
          <div id="container-ds-inputs" class="hidden flex items-center gap-2 w-full sm:w-auto flex-wrap">
            <div class="flex items-center bg-[#090d16] border border-slate-900 rounded p-1 gap-1">
              <span class="text-[9px] text-slate-500 font-bold uppercase tracking-wider font-technical pl-1">Val</span>
              <input type="number" id="input-ds-val" class="bg-transparent border-none outline-none text-xs placeholder-slate-700 w-[50px] font-technical text-slate-200 px-2 py-1.5 focus:outline-none focus:ring-0 text-center" placeholder="42" value="42">
            </div>
            <button id="btn-ds-push" class="tech-btn text-xs px-3 py-2.5 rounded font-bold uppercase tracking-wider" title="Push element onto Stack">
              Push (Stack)
            </button>
            <button id="btn-ds-pop" class="tech-btn text-xs px-3 py-2.5 rounded font-bold uppercase tracking-wider" title="Pop top element from Stack">
              Pop (Stack)
            </button>
            <button id="btn-ds-enqueue" class="tech-btn text-xs px-3 py-2.5 rounded font-bold uppercase tracking-wider" title="Enqueue element to Queue">
              Enqueue (Queue)
            </button>
            <button id="btn-ds-dequeue" class="tech-btn text-xs px-3 py-2.5 rounded font-bold uppercase tracking-wider" title="Dequeue front element from Queue">
              Dequeue (Queue)
            </button>
          </div>

          <!-- Graph Option Controls (shown only for Graph algorithms) -->
          <div id="container-graph-inputs" class="hidden flex items-center gap-2 w-full sm:w-auto flex-wrap">
            <div class="flex items-center bg-[#090d16] border border-slate-900 rounded p-1 gap-1 focus-within:border-cyan-500/40 focus-within:shadow-[0_0_10px_rgba(6,182,212,0.15)] transition duration-200">
              <span class="text-[9px] text-slate-500 font-bold uppercase tracking-wider font-technical pl-2">Algorithm</span>
              <select id="select-graph-algo" class="tech-input text-xs bg-[#090d16] border-none outline-none text-slate-200 px-2 py-1.5 font-technical focus:outline-none focus:ring-0">
                <option value="bfs" selected>BFS Traversal</option>
                <option value="dfs">DFS Traversal</option>
                <option value="prim">Prim's MST</option>
                <option value="kruskal">Kruskal's MST</option>
              </select>
              <span class="text-[9px] text-slate-500 font-bold uppercase tracking-wider font-technical border-l border-slate-800 pl-2">Start</span>
              <select id="select-graph-start" class="tech-input text-xs bg-[#090d16] border-none outline-none text-slate-200 px-2 py-1.5 font-technical focus:outline-none focus:ring-0">
                <option value="A" selected>Node A</option>
                <option value="B">Node B</option>
                <option value="C">Node C</option>
                <option value="D">Node D</option>
                <option value="E">Node E</option>
                <option value="F">Node F</option>
              </select>
            </div>
          </div>

          <!-- Random Array Generator -->
          <div id="container-randomize" class="flex items-center gap-2 w-full sm:w-auto flex-wrap">
            <div class="flex items-center bg-[#090d16] border border-slate-900 rounded p-1 gap-1 focus-within:border-cyan-500/40 focus-within:shadow-[0_0_10px_rgba(6,182,212,0.15)] transition duration-200">
              <span class="text-[9px] text-slate-500 font-bold uppercase tracking-wider font-technical pl-1">Len</span>
              <input type="number" id="random-length" class="bg-transparent border-none outline-none text-xs placeholder-slate-700 w-[38px] font-technical text-slate-200 px-1 py-1.5 focus:outline-none focus:ring-0 text-center" placeholder="8" min="3" max="15" value="8">
              <span class="text-[9px] text-slate-500 font-bold uppercase tracking-wider font-technical border-l border-slate-800 pl-1">Min</span>
              <input type="number" id="random-min" class="bg-transparent border-none outline-none text-xs placeholder-slate-700 w-[38px] font-technical text-slate-200 px-1 py-1.5 focus:outline-none focus:ring-0 text-center" placeholder="1" min="1" max="99" value="1">
              <span class="text-[9px] text-slate-500 font-bold uppercase tracking-wider font-technical border-l border-slate-800 pl-1">Max</span>
              <input type="number" id="random-max" class="bg-transparent border-none outline-none text-xs placeholder-slate-700 w-[38px] font-technical text-slate-200 px-1 py-1.5 focus:outline-none focus:ring-0 text-center" placeholder="99" min="2" max="99" value="99">
            </div>
            <button id="btn-randomize" class="tech-btn text-xs px-3 py-2.5 rounded font-bold uppercase tracking-wider" title="Generate a random array with the given parameters">
              Randomize
            </button>
          </div>

          <!-- Dynamic Maze Generator Selector -->
          <div id="container-maze-select" class="hidden flex items-center bg-[#090d16] border border-slate-900 rounded p-1 gap-1 focus-within:border-cyan-500/40 focus-within:shadow-[0_0_10px_rgba(6,182,212,0.15)] transition duration-200 w-full sm:w-auto">
            <span class="text-[9px] text-slate-500 font-bold uppercase tracking-wider font-technical pl-2">Maze</span>
            <select id="select-maze-type" class="tech-input text-xs bg-[#090d16] border-none outline-none text-slate-200 px-2 py-1.5 font-technical focus:outline-none focus:ring-0">
              <option value="recursive-division">Recursive Division</option>
              <option value="prims">Prim's Maze</option>
              <option value="random">Random Obstacles</option>
            </select>
            <button id="btn-generate-maze" class="tech-btn text-xs px-3 py-1.5 rounded font-bold uppercase tracking-wider" title="Generate maze obstacles on grid">
              Generate
            </button>
            <button id="btn-toggle-paint" class="tech-btn text-xs px-3 py-1.5 rounded font-bold uppercase tracking-wider border border-amber-500/40 text-amber-300" title="Toggle paint tool between Wall and Weight (Cost 5)">
              Tool: Wall
            </button>
          </div>
        </div>

      </div>

      <!-- Sidebar Registers / Complexity / Code (1 column wide) -->
      <div class="flex flex-col space-y-6">
        
        <!-- Engine Status & Diagnostics HUD -->
        <div class="cyber-panel p-4 flex justify-between items-center bg-[#090d15]/90">
          <div>
            <span class="text-[9px] text-slate-500 font-technical uppercase block">Engine State</span>
            <div class="flex items-center gap-2 mt-1">
              <span id="status-led" class="led-indicator led-standby"></span>
              <span id="status-text" class="text-xs font-technical font-bold text-slate-200">READY</span>
            </div>
          </div>
          <div class="text-right border-l border-slate-900 pl-4">
            <span class="text-[9px] text-slate-500 font-technical uppercase block">Active Step</span>
            <span id="stat-step" class="text-sm font-technical font-bold text-[#00e1d9]">1 / 1</span>
          </div>
        </div>

        <!-- Telemetry & Variable HUD -->
        <div class="cyber-panel p-4 flex flex-col">
          <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-900">
            <span class="text-xs font-bold text-slate-200 font-technical uppercase tracking-wider">State Registers HUD</span>
            <span class="text-[9px] text-slate-500 font-technical">TELEMETRY</span>
          </div>
          <div class="max-h-[140px] overflow-y-auto">
            <table class="hud-table">
              <thead>
                <tr>
                  <th>Register</th>
                  <th class="text-right">Value</th>
                </tr>
              </thead>
              <tbody id="hud-variables-body">
                <!-- Dynamically populated variables go here -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Complexity and Stats HUD -->
        <div class="cyber-panel p-4 grid grid-cols-2 gap-4 bg-[#090d15]/50">
          <div class="col-span-2 border-b border-slate-900 pb-2 flex justify-between items-center">
            <span class="text-xs font-bold text-slate-200 font-technical uppercase tracking-wider">Performance Analytics</span>
            <span class="text-[9px] text-slate-500 font-technical">HUD</span>
          </div>
          <div class="bg-slate-950/40 p-2.5 rounded border border-slate-900">
            <span class="text-[9px] text-slate-500 font-technical uppercase block">Comparisons</span>
            <span id="stat-comparisons" class="text-lg font-technical font-bold text-[#f59e0b]">0</span>
          </div>
          <div class="bg-slate-950/40 p-2.5 rounded border border-slate-900">
            <span class="text-[9px] text-slate-500 font-technical uppercase block">Swaps / Writes</span>
            <span id="stat-swaps" class="text-lg font-technical font-bold text-[#f43f5e]">0</span>
          </div>
          <div class="bg-slate-950/40 p-2.5 rounded border border-slate-900">
            <span class="text-[9px] text-slate-500 font-technical uppercase block">Complexity (Time)</span>
            <span id="stat-complexity-time" class="text-xs font-technical font-bold text-[#10b981] block mt-1">O(n)</span>
          </div>
          <div class="bg-slate-950/40 p-2.5 rounded border border-slate-900">
            <span class="text-[9px] text-slate-500 font-technical uppercase block">Complexity (Space)</span>
            <span id="stat-complexity-space" class="text-xs font-technical font-bold text-[#10b981] block mt-1">O(1)</span>
          </div>
        </div>

        <!-- Call Stack HUD (shown only for recursive algorithms) -->
        <div id="callstack-panel" class="cyber-panel p-4 flex-col hidden">
          <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-900">
            <span class="text-xs font-bold text-slate-200 font-technical uppercase tracking-wider">Call Stack</span>
            <span class="text-[9px] text-slate-500 font-technical">RECURSION FRAMES</span>
          </div>
          <div id="callstack-container" class="flex flex-col-reverse gap-1 max-h-[160px] overflow-y-auto">
            <!-- Call stack frames go here -->
          </div>
        </div>

        <!-- Explanation/Code Card -->
        <div class="cyber-panel overflow-hidden flex flex-col flex-1 min-h-[300px]">
          <!-- Heading -->
          <div class="bg-slate-950/70 px-4 py-3 border-b border-slate-900 flex justify-between items-center">
            <h3 class="text-xs font-bold text-slate-300 uppercase tracking-widest font-technical">Instruction Set</h3>
            <div class="flex items-center gap-2">
              <button id="btn-share-link" class="tech-btn text-[9px] px-2 py-1 rounded font-technical font-bold uppercase" title="Copy Permalink URL Hash to Clipboard">
                🔗 Share Link
              </button>
              <button id="btn-copy-code" class="tech-btn text-[9px] px-2 py-1 rounded font-technical font-bold uppercase" title="Copy Pseudocode to Clipboard">
                📋 Copy Code
              </button>
              <button id="btn-export-algo" class="tech-btn text-[9px] px-2 py-1 rounded font-technical font-bold uppercase" title="Export Custom Algorithm Package">
                📤 Export Package
              </button>
              <button id="btn-import-algo" class="tech-btn text-[9px] px-2 py-1 rounded font-technical font-bold uppercase" title="Import Custom Algorithm Package">
                📥 Import Package
              </button>
              <input type="file" id="input-import-algo" class="hidden" accept=".algovisual">
              <button id="btn-toggle-sandbox" class="tech-btn text-[9px] px-2 py-1 rounded font-technical font-bold uppercase" title="Toggle Sandbox Code Editor">
                Sandbox Mode
              </button>
              <span id="label-code-type" class="text-[9px] text-slate-500 font-technical">PSEUDOCODE</span>
            </div>
          </div>
          
          <!-- Code view -->
          <div id="pseudocode-container" class="flex-1 py-3 overflow-y-auto bg-slate-950/10">
            <!-- Pseudocode lines go here -->
          </div>

          <!-- Sandbox Editor View -->
          <div id="sandbox-container" class="hidden flex-1 flex flex-col bg-slate-950/15 overflow-hidden">
            <!-- Breakpoints Toolbar -->
            <div id="sandbox-breakpoints-bar" class="px-3 py-1.5 border-b border-slate-900 bg-slate-950/60 flex items-center justify-between text-[10px] text-slate-400 font-technical">
              <div class="flex items-center gap-2">
                <span class="text-cyan-400 font-bold">🔴 Breakpoints:</span>
                <input type="number" id="input-breakpoint-line" class="bg-slate-950 border border-slate-900 text-cyan-400 px-2 py-0.5 rounded w-14 text-center font-technical focus:outline-none" placeholder="Line #" min="1">
                <button id="btn-toggle-breakpoint" class="tech-btn text-[9px] px-2 py-0.5 rounded font-bold uppercase" title="Add/Remove Breakpoint at line number">
                  Set Breakpoint
                </button>
              </div>
              <span id="text-active-breakpoints" class="text-[9px] text-slate-500 font-technical">None</span>
            </div>

            <!-- Syntax-highlight backdrop + transparent textarea overlay -->
            <div id="sandbox-editor-wrap" class="flex-1 relative overflow-hidden">
              <div id="sandbox-highlight" class="sandbox-highlight" aria-hidden="true"></div>
              <textarea id="sandbox-textarea" class="sandbox-textarea" spellcheck="false"></textarea>
            </div>

            <!-- Sandbox Benchmark Panel (initially hidden) -->
            <div id="sandbox-benchmark-panel" class="hidden border-t border-slate-900 bg-slate-950/80 p-4 flex flex-col gap-2">
              <div class="flex justify-between items-center">
                <span class="text-[10px] font-bold text-slate-300 font-technical uppercase">Time Complexity Benchmark (Execution vs Size)</span>
                <button id="btn-close-benchmark" class="text-xs text-slate-500 hover:text-slate-300 font-bold px-1">&times;</button>
              </div>
              <div class="flex items-center justify-center my-2 bg-slate-950/90 rounded border border-slate-900 p-2 min-h-[160px]" id="benchmark-chart-container">
                <!-- SVG chart goes here -->
              </div>
            </div>

            <div class="p-2 border-t border-slate-900 bg-slate-950/60 flex justify-between items-center gap-2">
              <span class="text-[9px] text-slate-500 font-technical">Format: function(arr, target) { ... }</span>
              <div class="flex gap-2">
                <button id="btn-benchmark-sandbox" class="tech-btn px-3 py-1 rounded text-[10px] font-bold uppercase tracking-wider" title="Benchmark complexity across different data sizes">
                  Benchmark
                </button>
                <button id="btn-run-sandbox" class="tech-btn tech-btn-primary px-3 py-1 rounded text-[10px] font-bold uppercase tracking-wider">
                  Run Code
                </button>
              </div>
            </div>
          </div>

          <!-- Narration Text Block -->
          <div class="p-4 bg-[#090d15] border-t border-slate-900 border-b border-slate-900">
            <p id="narrative-text" class="text-xs font-medium text-slate-300 leading-relaxed min-h-[44px] cursor-pointer hover:text-cyan-400 transition-colors" title="Double-click to edit narration text"></p>
          </div>

          <!-- Narrative Log Console -->
          <div class="flex flex-col h-[140px] bg-slate-950/50">
            <div class="bg-slate-950/80 px-4 py-2 border-b border-slate-900 flex justify-between items-center">
              <span class="text-[10px] font-bold text-slate-400 font-technical tracking-wider uppercase">Execution Debug Logs</span>
              <div class="flex items-center gap-2">
                <button id="btn-export-log" class="tech-btn text-[9px] px-2 py-0.5 rounded font-technical font-bold uppercase" title="Export Execution Logs to Text File">
                  Export Log
                </button>
                <span class="text-[9px] text-slate-600 font-technical">FIFO_QUEUE</span>
              </div>
            </div>
            <div id="console-log" class="flex-1 overflow-y-auto p-3 space-y-1">
              <!-- Append history steps log -->
            </div>
          </div>
        </div>

      </div>

    </div>

  </div>

  <!-- Load player as ES6 module -->
  <script type="module">
    import { initPlayer } from '/js/player.js';
    document.addEventListener('DOMContentLoaded', () => {
      initPlayer('<%= algo %>');
    });
  </script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggleBtn = document.getElementById('theme-toggle');
      const toggleIcon = document.getElementById('theme-toggle-icon');
      
      const updateToggleIcon = () => {
        if (toggleIcon) {
          const isLight = document.documentElement.classList.contains('light-theme');
          toggleIcon.textContent = isLight ? '🌙' : '☀️';
        }
      };
      
      updateToggleIcon();
      
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const isLight = document.documentElement.classList.toggle('light-theme');
          localStorage.setItem('theme', isLight ? 'light' : 'dark');
          updateToggleIcon();
        });
      }
    });
  </script>
</body>
</html>
